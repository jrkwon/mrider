<?xml version="1.0"?>
<!--
  MITT chassis, wheels and steering linkage.

  EVERY dimension comes from config/mitt_dimensions.yaml. There are no
  geometric literals in this file by design: measured values must be able to
  drop in without anyone editing geometry. If you find yourself typing a
  number here, put it in the yaml instead.

  Frame convention (REP-105, docs/design/software.md 3.3):
    base_link = REAR AXLE CENTRE, on the ground plane, X forward, Y left, Z up.

  Steering model: two front steer joints (position-commanded) plus two rear
  traction joints (velocity-commanded), matching upstream
  ackermann_steering_controller. The front road wheels spin on passive joints.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find mitt_description)/urdf/inertial_macros.xacro"/>

  <!-- ==== Load the single source of truth ================================= -->
  <xacro:property name="d" value="${xacro.load_yaml('$(find mitt_description)/config/mitt_dimensions.yaml')}"/>

  <xacro:property name="wheelbase"      value="${d['wheelbase']}"/>
  <xacro:property name="track"          value="${d['track_width']}"/>
  <xacro:property name="wheel_r"        value="${d['wheel_radius']}"/>
  <xacro:property name="wheel_w"        value="${d['wheel_width']}"/>
  <xacro:property name="body_l"         value="${d['chassis_length']}"/>
  <xacro:property name="body_w"         value="${d['chassis_width']}"/>
  <xacro:property name="body_h"         value="${d['chassis_height']}"/>
  <xacro:property name="chassis_mass"   value="${d['chassis_mass']}"/>
  <xacro:property name="wheel_mass"     value="${d['wheel_mass']}"/>
  <xacro:property name="payload_mass"   value="${d['payload_mass']}"/>
  <xacro:property name="steer_limit"    value="${radians(d['steer_limit_deg'])}"/>
  <xacro:property name="max_steer_rate" value="${d['max_steer_rate']}"/>

  <!-- Body box is centred between the axles, lifted so its floor clears the
       ground by roughly a third of a wheel radius. -->
  <xacro:property name="body_cx" value="${wheelbase/2}"/>
  <xacro:property name="body_cz" value="${wheel_r + body_h/2 - wheel_r/3}"/>

  <material name="mitt_white"><color rgba="0.92 0.92 0.92 1.0"/></material>
  <material name="mitt_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="mitt_accent"><color rgba="0.10 0.35 0.65 1.0"/></material>

  <!-- ==== base_link ======================================================= -->
  <!-- Massless reference frame at the rear axle centre, on the ground. -->
  <link name="base_link"/>

  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="mitt_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${body_l}" y="${body_w}" z="${body_h}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="${body_cx} 0 ${body_cz}" rpy="0 0 0"/>
  </joint>

  <!-- ==== Equipment plate ================================================= -->
  <!--
    The removed seat is replaced by a plate carrying laptop + LiDAR + control
    box. At ~6 kg on a ~8 kg chassis, carried above the body line, this
    dominates the roll inertia.

    It is modelled as a REAL link with REAL mass on purpose: the tip-over
    margin is a genuine risk introduced by the 12 V single-seater class, and
    a twin that hides it would be worse than useless.
  -->
  <xacro:property name="plate_l" value="${body_l*0.40}"/>
  <xacro:property name="plate_w" value="${body_w*0.70}"/>
  <xacro:property name="plate_h" value="0.02"/>
  <xacro:property name="plate_z" value="${wheel_r + body_h*0.75}"/>

  <link name="equipment_plate_link">
    <visual>
      <geometry><box size="${plate_l} ${plate_w} ${plate_h}"/></geometry>
      <material name="mitt_dark"/>
    </visual>
    <collision>
      <geometry><box size="${plate_l} ${plate_w} ${plate_h}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${payload_mass}" x="${plate_l}" y="${plate_w}" z="${plate_h}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="equipment_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="equipment_plate_link"/>
    <origin xyz="${wheelbase*0.45} 0 ${plate_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==== Wheel macros ==================================================== -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="mitt_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_w}" radius="${wheel_r}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <!-- Rear wheels: traction, velocity-commanded.
       NOTE both rear motors are paralleled onto ONE motor-driver channel with
       a SINGLE encoder on the real vehicle (docs/design/dbw.md 7, ADR C), so
       independent rear-wheel feedback does not exist in hardware. -->
  <xacro:macro name="rear_wheel" params="side reflect">
    <xacro:wheel_link name="rear_${side}_wheel_link"/>
    <joint name="rear_${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rear_${side}_wheel_link"/>
      <origin xyz="0 ${reflect*track/2} ${wheel_r}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- Front corners: a steer link (position-commanded, clamped to the
       mechanical lock) carrying a passive road wheel. -->
  <xacro:macro name="front_corner" params="side reflect">
    <link name="front_${side}_steer_link">
      <visual>
        <geometry><cylinder radius="${wheel_r*0.18}" length="${wheel_w*0.5}"/></geometry>
        <material name="mitt_accent"/>
      </visual>
      <xacro:inertial_cylinder mass="0.2" length="${wheel_w*0.5}" radius="${wheel_r*0.18}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="front_${side}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_steer_link"/>
      <origin xyz="${wheelbase} ${reflect*track/2} ${wheel_r}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steer_limit}" upper="${steer_limit}"
             effort="50.0" velocity="${max_steer_rate}"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <xacro:wheel_link name="front_${side}_wheel_link"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_steer_link"/>
      <child link="front_${side}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel side="left"  reflect="1"/>
  <xacro:rear_wheel side="right" reflect="-1"/>
  <xacro:front_corner side="left"  reflect="1"/>
  <xacro:front_corner side="right" reflect="-1"/>

  <!-- ==== Gazebo surface properties ====================================== -->
  <!-- Hollow plastic wheels on a smooth indoor floor. mu is a guess and is
       one of the first things to tune against measured odometry drift. -->
  <xacro:macro name="wheel_gz" params="name">
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_gz name="rear_left_wheel_link"/>
  <xacro:wheel_gz name="rear_right_wheel_link"/>
  <xacro:wheel_gz name="front_left_wheel_link"/>
  <xacro:wheel_gz name="front_right_wheel_link"/>

  <gazebo reference="chassis_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="equipment_plate_link"><material>Gazebo/DarkGrey</material></gazebo>

</robot>
