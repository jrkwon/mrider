<?xml version="1.0" ?>
<!--
  MITT indoor test world.

  The environment is the OpenRobotics "Depot" model pulled from Gazebo Fuel at
  first run and cached under ~/.gz/fuel. Only this wrapper is committed - the
  meshes are not vendored into the repo.

  ATTRIBUTION (required by the licence):
    "Depot" by Open Robotics, https://app.gazebosim.org/OpenRobotics/fuel/models/Depot
    Licensed CC BY 4.0 - https://creativecommons.org/licenses/by/4.0/

  WHY THIS MODEL. Licence was the deciding factor, not popularity. The
  obvious pick - OpenRobotics/Warehouse, 96k downloads - is CC BY-NC-ND:
  NonCommercial AND NoDerivatives. For a platform whose stated purpose is
  external replication and a course kit, a NoDerivatives dependency is a bad
  bet. Depot is CC BY 4.0 (attribution only), 47k downloads, PBR materials,
  and is an indoor space with walls, aisles and shelving - a reasonable proxy
  for the hallway the semester-1 gate actually measures against.

  This is NOT the acceptance-gate environment. That gate is a >= 30 m real
  hallway loop (docs/design/software.md 8). A parametric hallway world
  matching the real building should be added once the test space is confirmed.
-->
<sdf version="1.9">
  <world name="depot">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <!-- Sensors system renders the gpu_lidar and camera declared in the URDF. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Indoor spaces are lit from inside; the directional sun alone leaves
         the aisles too dark for the camera to be useful. -->
    <light type="point" name="interior_light">
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.4</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Depot</uri>
      <name>depot</name>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

  </world>
</sdf>
